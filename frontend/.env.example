# Prop-Tech frontend environment variables (Vite)
# Copy sang .env.local va dien gia tri that. KHONG commit .env.local.

# Base URL cua backend Prop-Tech (.NET)
VITE_API_BASE_URL=http://localhost:5052

# Goong REST API key (autocomplete/place-detail/geocode V2 cho ban do chon vi tri)
VITE_GOONG_API_KEY=
# Goong MapTiles key (neu doi nen ban do sang Goong sau nay)
VITE_GOONG_MAPTILES_KEY=

# Tich hop TroUyTin (nhan tin/realtime lien he)
VITE_TROUYTIN_API_BASE_URL=http://localhost:8090
VITE_TROUYTIN_WS_URL=
VITE_TROUYTIN_INTERNAL_API_KEY=
VITE_TROUYTIN_WEB_BASE_URL=http://localhost:3000
